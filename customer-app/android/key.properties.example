# Android release signing — copy to key.properties and fill in.
# DO NOT commit key.properties or the .jks keystore to git.
#
# Create a keystore first:
#   keytool -genkey -v -keystore azberry-customer.jks -keyalg RSA -keysize 2048 -validity 10000 -alias azberry
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=azberry
storeFile=azberry-customer.jks
